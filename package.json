{
  "name": "privacy-mining",
  "version": "1.0.0",
  "description": "Contracts for Silent's Privacy Mining Program",
  "main": "index.js",
  "scripts": {
    "hardhat": "hardhat",
    "prettier": "prettier --write './**/*.{ts,tsx}'",
    "lint": "yarn run lint:eslint && yarn run lint:solhint",
    "lint:eslint": "eslint .",
    "lint:solhint": "solhint contracts/**/*.sol",
    "test:echidna": "yarn hardhat compile && echidna-test . --contract EchidnaPMC --config contracts/echidna-tests/echidna-config.yaml",
    "test:unit-sc": "rm -rf artifacts && rm -rf test/__snapshots__ && yarn hardhat node & yarn hardhat test",
    "deploy:with-setup": "rm -rf artifacts && rm -rf cache && yarn hardhat node",
    "deploy:wo-setup": "rm -rf artifacts && rm -rf cache && yarn hardhat node --no-deploy & yarn hardhat run scripts/deploy/deploy-contracts.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silent-Protocol/privacy-mining.git"
  },
  "keywords": [
    "staking"
  ],
  "author": "SILENTDAO FOUNDATION",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Silent-Protocol/privacy-mining/issues"
  },
  "homepage": "https://github.com/Silent-Protocol/privacy-mining#readme",
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@gnosis.pm/safe-core-sdk": "^3.1.1",
    "@gnosis.pm/safe-core-sdk-types": "^1.6.1",
    "@gnosis.pm/safe-ethers-lib": "^1.6.1",
    "@gnosis.pm/safe-service-client": "^1.3.1",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.4",
    "@nomicfoundation/hardhat-toolbox": "^1.0.2",
    "@nomiclabs/hardhat-ethers": "npm:hardhat-deploy-ethers",
    "@nomiclabs/hardhat-etherscan": "^3.1.0",
    "@nomiclabs/hardhat-solhint": "^2.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "@openzeppelin/contracts": "^4.7.3",
    "@openzeppelin/test-helpers": "^0.5.15",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.3",
    "@types/chai": "^4.3.3",
    "@types/jest": "^29.2.2",
    "@types/node": "^18.11.3",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "chai": "^4.3.6",
    "chai-ethers": "^0.0.1",
    "eslint": "^8.27.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "ethers": "^5.7.2",
    "hardhat": "^2.10.2",
    "hardhat-deploy": "^0.11.18",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^2.7.1",
    "prettier-plugin-solidity": "^1.0.0-rc.1",
    "solhint": "^3.3.7",
    "solidity-coverage": "^0.7.21",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@uniswap/snapshot-gas-cost": "^1.0.0",
    "dotenv": "^16.0.3",
    "hardhat-contract-sizer": "^2.6.1",
    "mocha-chai-jest-snapshot": "^1.1.4"
  }
}
